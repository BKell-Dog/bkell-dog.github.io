{% extends "layouts/notebook.njk" %}

{% block content %}
<article class="post">
	<header class="flex-column">
    	<h1>{{ title }}</h1>
    	<time datetime="{{ page.date | formatDate("YYYY-MM-DD") }}">{{ page.date | formatDate }}</time>
  	</header>
  	<hr class="hr-short short-margin">
  	<div class="content">
		{{ content | safe }}
	</div>
</article>
{% endblock %}